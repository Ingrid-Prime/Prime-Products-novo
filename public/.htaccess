DirectoryIndex index.html
Options -MultiViews
RewriteEngine On

ErrorDocument 404 /404.html

# Forcar www (Canonical Domain) mantendo path/query
RewriteCond %{HTTP_HOST} ^primeproducts\.ind\.br$ [NC]
RewriteRule ^(.*)$ https://www.primeproducts.ind.br/$1 [R=301,L]

# Forcar HTTPS mantendo path/query
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Excecoes estritas
RewriteRule ^(robots\.txt|sitemap\.xml|404\.html)$ - [L]

# Se for arquivo ou diretorio fisico (ex: os HTMLs estaticos gerados pelo prerender)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
RewriteRule ^ - [L]

# Se existe um index.html dentro da pasta da rota prerenderizada
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /index.html [L]

# Fallback final para rotas invalidas = ERRO 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
